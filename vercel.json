{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'no install'",
  "buildCommand": "echo 'static site'",
  "outputDirectory": "netlify-site",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/namoz", "destination": "/namoz.html" },
    { "source": "/ramazon", "destination": "/index.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/wp-admin", "destination": "/admin.html" },
    { "source": "/wp-admin/:path*", "destination": "/admin.html" },
    { "source": "/wp-login.php", "destination": "/admin.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
